{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ppi-laboratorio:review:1.0.0",
  "title": "Revisão docente versionada v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submission_id",
        "participant_id",
        "decision",
        "criteria_version",
        "scores",
        "justification",
        "expected_revision"
      ],
      "properties": {
        "submission_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "participant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "decision": {
          "enum": [
            "PROPOSTA",
            "EM_REVISAO",
            "APROVADA",
            "DEVOLVIDA"
          ]
        },
        "criteria_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scores": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion_id",
              "score"
            ],
            "properties": {
              "criterion_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "multipleOf": 0.01
              }
            }
          }
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$comment": "Servidor valida permissão docente, critério único, limites da rubrica, autoria e revisão atual. Schema não autoriza lançamento."
}
