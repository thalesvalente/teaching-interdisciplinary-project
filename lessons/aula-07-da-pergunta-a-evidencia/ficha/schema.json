{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thalesvalente.github.io/teaching-interdisciplinary-project/lessons/aula-07-da-pergunta-a-evidencia/ficha/schema.json",
  "title": "Ficha Avaliativa PPI Aula 07 — rascunho 1.0.0",
  "description": "Contrato fechado. model.js valida este contrato sem carregar rede; acrescenta limites totais (512 KB), profundidade (12), IDs únicos, referências aos integrantes, data calendárica e URL HTTPS. exportedAt e score são metadados descartáveis; pontuação sempre recalculada.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "worksheetVersion": {
      "const": "1.0.0"
    },
    "rubricVersion": {
      "const": "1.0.0"
    },
    "team": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "date": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
        },
        "track": {
          "type": "string",
          "enum": [
            "",
            "memorias",
            "permanencia"
          ]
        },
        "repository": {
          "type": "string",
          "maxLength": 2048,
          "description": "Vazio ou HTTPS absoluto, sem credenciais; validação adicional em model.js."
        },
        "declaration": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "date",
        "track",
        "repository",
        "declaration"
      ],
      "additionalProperties": false
    },
    "members": {
